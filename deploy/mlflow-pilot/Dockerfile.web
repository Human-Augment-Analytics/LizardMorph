FROM node:22-bookworm-slim AS build
WORKDIR /frontend
COPY frontend/package*.json ./
RUN npm ci
COPY frontend ./
ENV VITE_API_URL=/api VITE_MODEL_API_URL=/model-api
RUN npm run build
FROM nginx:1.28-alpine
COPY --from=build /frontend/dist /usr/share/nginx/html
COPY deploy/mlflow-pilot/nginx.conf /etc/nginx/conf.d/default.conf
